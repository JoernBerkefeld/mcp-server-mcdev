{
    "name": "mcp-server-mcdev",
    "version": "1.1.1",
    "mcpName": "io.github.JoernBerkefeld/mcp-server-mcdev",
    "description": "Native mcdev workflows through AI: retrieve, build, deploy, command discovery and offline SFMC DevTools documentation.",
    "author": "JÃƒÂ¶rn Berkefeld",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/JoernBerkefeld/mcp-server-mcdev.git"
    },
    "bugs": {
        "url": "https://github.com/JoernBerkefeld/mcp-server-mcdev/issues"
    },
    "homepage": "https://github.com/JoernBerkefeld/mcp-server-mcdev#readme",
    "keywords": [
        "mcp",
        "model-context-protocol",
        "mcdev",
        "sfmc",
        "salesforce",
        "marketing-cloud",
        "devtools"
    ],
    "type": "module",
    "bin": {
        "mcp-server-mcdev": "./dist/index.js"
    },
    "main": "./dist/index.js",
    "exports": {
        ".": "./dist/index.js"
    },
    "files": [
        "dist",
        "bundled",
        "data",
        "README.md",
        "LICENSE",
        "server.json"
    ],
    "scripts": {
        "prepublishOnly": "npm run build",
        "version": "node scripts/sync-server-version.mjs",
        "bundle-wiki": "node scripts/bundle-wiki.mjs",
        "build": "npm run bundle-wiki && tsc -p tsconfig.json",
        "dev": "tsc -p tsconfig.json --watch",
        "start": "node dist/index.js",
        "test": "node --test tests/*.test.mjs",
        "clean": "node -e \"import fs from 'fs'; fs.rmSync('dist', { recursive: true, force: true });\"",
        "lint": "eslint .",
        "lint:fix": "eslint --fix .",
        "prepare": "husky || true",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.31.0",
        "mcdev": "^10.1.0",
        "zod": "^4.4.3"
    },
    "engines": {
        "node": "^22.22.2 || >=24.15.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^22.19.17",
        "eslint": "^10.1.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-jsdoc": "^62.0.0",
        "eslint-plugin-prettier": "^5.5.0",
        "eslint-plugin-unicorn": "^64.0.0",
        "globals": "^17.4.0",
        "husky": "^9.1.7",
        "lint-staged": "^17.0.5",
        "prettier": "^3.8.1",
        "typescript": "^5.9.0",
        "typescript-eslint": "^8.57.2"
    },
    "lint-staged": {
        "*.{js,mjs,cjs,ts}": [
            "eslint --fix"
        ]
    }
}
